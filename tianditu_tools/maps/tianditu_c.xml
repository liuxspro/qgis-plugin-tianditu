      <ows:Title>天地图 - 矢量地图（EPSG:4490）</ows:Title>
      <ows:Abstract>天地图 - 矢量地图（EPSG:4490）</ows:Abstract>
      <ows:WGS84BoundingBox>
        <ows:LowerCorner>-180 -85.051129</ows:LowerCorner>
        <ows:UpperCorner>180 85.051129</ows:UpperCorner>
      </ows:WGS84BoundingBox>
      <ows:Identifier>tianditu_vec_c</ows:Identifier>
      <Style>
        <ows:Identifier>default</ows:Identifier>
      </Style>
      <Format>image/png</Format>
      <TileMatrixSetLink>
        <TileMatrixSet>CGCS2000Quad</TileMatrixSet>
      </TileMatrixSetLink>
      <ResourceURL
                format="image/png"
                resourceType="tile"
                template="https://t6.tianditu.gov.cn/DataServer?T=vec_c&amp;x={TileCol}&amp;y={TileRow}&amp;l={TileMatrix}&amp;tk={tk}"
            />
    </Layer>
